<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Stackify.ApiKey" value="SECRET-TEST-KEY-DO-NOT-LEAK" />
    <add key="Stackify.AppName" value="Sample.LegacyIis" />
    <add key="Stackify.Environment" value="Production" />
  </appSettings>
  <log4net>
    <root>
      <level value="DEBUG" />
      <appender-ref ref="StackifyAppender" />
    </root>
    <appender name="StackifyAppender" type="StackifyLib.log4net.StackifyAppender, StackifyLib.log4net">
      <threshold value="DEBUG" />
    </appender>
  </log4net>
  <system.web>
    <compilation debug="true" targetFramework="4.6.2" />
  </system.web>
</configuration>
